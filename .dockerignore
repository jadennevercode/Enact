# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
**/.next
.turbo
**/.turbo
dist
**/dist
server/bin
server/tmp

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage
**/coverage

# Docs
/docs/
*.md

# Only the web workspace is used by Dockerfile.web. Default-exclude future
# app workspaces so they do not silently enter the build context.
/apps/*
!/apps/web/

# Keep generated workspace files excluded after re-including the web app.
# Docker evaluates the last matching rule, including parent directory rules.
**/node_modules
**/.next
**/.turbo
**/dist
**/*.tsbuildinfo

# Repository-only tooling
/.github/
/deploy/
/scripts/

# The optional account importer needs only its program, never the data or key.
!/scripts/account-bundle.mjs
!/deploy/demo/Dockerfile
/data/
